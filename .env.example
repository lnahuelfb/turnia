# ---------------------------------------------------------------------------
# Turnia — variables de entorno. Copiar a `.env` y completar.
# Usamos `.env` (no `.env.local`) porque lo leen tanto Next.js como el
# CLI de Prisma. Está gitignoreado.
# ---------------------------------------------------------------------------

# --- Base de datos (Supabase Postgres) -------------------------------------
# Pooler (pgbouncer, puerto 6543) — usado por la app en runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (puerto 5432) — usada por `prisma migrate`.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase (Auth / Storage / Realtime) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
SUPABASE_SERVICE_ROLE_KEY="ey..."   # solo server-side, nunca exponer al cliente

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="America/Argentina/Buenos_Aires"

# --- Web Push (VAPID) ---------------------------------------------------
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hola@turnia.app"

# --- Email transaccional (Resend) ---------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Turnia <turnos@turnia.app>"

# --- Mercado Pago Suscripciones ---------------------------------------
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_BASE_PLAN_ID=""          # id del plan de preapproval base

# --- Cloudflare Turnstile (anti-spam form público) --------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Operador / superadmin -------------------------------------------
# Emails con acceso al panel de operador, separados por coma.
OPERATOR_EMAILS="lnahuelfernandezb@gmail.com"

# --- Jobs (protección de endpoints de cron) --------------------------
CRON_SECRET=""
